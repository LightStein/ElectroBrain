# setup-access.ps1 - one-shot remote-access setup for George's Windows 11 laptop.
#
#   1. OpenSSH Server (key-only-ready, PowerShell 7 as the SSH shell)
#   2. Claude's public key installed for this account
#   3. cloudflared installed as a Windows service bound to the dashboard tunnel
#   4. Power settings so the laptop stays reachable (AC: never sleep, lid = nothing)
#   5. Prints an inventory (GPU/VRAM, RAM, disk, username) that Phase 1 needs
#
# HOW TO RUN
#   Log in as GEORGE'S OWN account (the one the assistant will run under).
#   Right-click Start -> "Terminal (Administrator)", then:
#       notepad C:\setup-access.ps1        <- paste this file, save, close
#       powershell -ExecutionPolicy Bypass -File C:\setup-access.ps1
#
# Nothing is exposed to the internet: cloudflared dials OUT to Cloudflare and
# reaches sshd on localhost only. No router/port-forwarding changes.
#
# THIS FILE IS DELIBERATELY PURE ASCII - DO NOT ADD em-dashes, box-drawing
# characters, ellipses, or Cyrillic. Windows PowerShell 5.1 reads .ps1 files
# using the system ANSI codepage (CP1251 on a Russian Windows) unless the file
# has a UTF-8 BOM, and Win11 Notepad saves UTF-8 WITHOUT a BOM. Under CP1251
# the byte 0x94 - which sits inside the UTF-8 encoding of both "-" (E2 80 94)
# and "-" box-drawing (E2 94 80) - decodes to a right double quotation mark,
# which PowerShell accepts as a STRING DELIMITER. One stray em-dash therefore
# opens a phantom string and the whole script fails to parse.

# --- FILL THIS IN -----------------------------------------------------------
$TunnelToken = "PASTE_TUNNEL_TOKEN_HERE"
# ----------------------------------------------------------------------------

$PublicKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDCl1bFz2nqR4lOdj+VVT6gkjfVikL6ZVTLG6WeyU0E/ claude@deltaops-george-laptop"

$ErrorActionPreference = "Stop"
function Step($n, $t) { Write-Host "`n=== $n. $t" -ForegroundColor Cyan }
function Ok($t)       { Write-Host "    [ok] $t" -ForegroundColor Green }
function Warn($t)     { Write-Host "    [!!] $t" -ForegroundColor Yellow }

if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
        ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "Run this from an ADMINISTRATOR terminal." -ForegroundColor Red
    exit 1
}
if ($TunnelToken -eq "PASTE_TUNNEL_TOKEN_HERE" -or $TunnelToken.Length -lt 40) {
    Write-Host "Set `$TunnelToken at the top of this file first." -ForegroundColor Red
    exit 1
}

$SshUser = $env:USERNAME
Write-Host "Setting up remote access for user: $SshUser" -ForegroundColor White

# --- 1. OpenSSH Server ------------------------------------------------------
Step 1 "OpenSSH Server"
$cap = Get-WindowsCapability -Online -Name "OpenSSH.Server*" | Select-Object -First 1
if ($cap.State -ne "Installed") {
    Add-WindowsCapability -Online -Name $cap.Name | Out-Null
    Ok "installed $($cap.Name)"
} else {
    Ok "already installed"
}
Set-Service -Name sshd -StartupType Automatic
Start-Service sshd
Ok "sshd running, starts at boot"

# --- 2. PowerShell 7 as the SSH shell ---------------------------------------
# Windows OpenSSH defaults to cmd.exe. PowerShell 7 gives proper UTF-8 (this
# project is full of Russian text) and sane quoting for remote one-liners.
Step 2 "SSH default shell"
$pwsh = "C:\Program Files\PowerShell\7\pwsh.exe"
if (-not (Test-Path $pwsh)) {
    try {
        Write-Host "    installing PowerShell 7 via winget (may take a minute)"
        winget install --id Microsoft.PowerShell --silent --accept-package-agreements --accept-source-agreements --disable-interactivity | Out-Null
    } catch {
        Warn "winget install failed: $($_.Exception.Message)"
    }
}
if (Test-Path $pwsh) {
    $shell = $pwsh
} else {
    $shell = "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe"
    Warn "PowerShell 7 unavailable, falling back to Windows PowerShell 5.1"
}
# New-Item -Force on an EXISTING registry key wipes its values, so check first.
if (-not (Test-Path "HKLM:\SOFTWARE\OpenSSH")) {
    New-Item -Path "HKLM:\SOFTWARE\OpenSSH" | Out-Null
}
New-ItemProperty -Path "HKLM:\SOFTWARE\OpenSSH" -Name DefaultShell -Value $shell -PropertyType String -Force | Out-Null
New-ItemProperty -Path "HKLM:\SOFTWARE\OpenSSH" -Name DefaultShellCommandOption -Value "-Command" -PropertyType String -Force | Out-Null
Ok "shell = $shell"

# --- 3. Authorized key ------------------------------------------------------
# Windows sshd has a Match-block quirk: keys for ADMIN accounts must live in
# C:\ProgramData\ssh\administrators_authorized_keys, not the user profile.
# We install into both so it works whether or not this account is an admin.
Step 3 "Public key"
$userKeys = Join-Path $env:USERPROFILE ".ssh\authorized_keys"
New-Item -ItemType Directory -Force -Path (Split-Path $userKeys) | Out-Null
if (-not (Test-Path $userKeys) -or -not (Select-String -Path $userKeys -SimpleMatch $PublicKey -Quiet)) {
    # ascii, NOT utf8: PowerShell 5.1 writes a BOM for utf8 and a BOM on the
    # first line makes sshd silently ignore that key. SSH keys are pure ASCII.
    Add-Content -Path $userKeys -Value $PublicKey -Encoding ascii
}
Ok "user file: $userKeys"

$adminKeys = "$env:ProgramData\ssh\administrators_authorized_keys"
if (-not (Test-Path $adminKeys) -or -not (Select-String -Path $adminKeys -SimpleMatch $PublicKey -Quiet)) {
    Add-Content -Path $adminKeys -Value $PublicKey -Encoding ascii
}
# ACL must be Administrators+SYSTEM only or sshd silently ignores the file.
# SIDs, not names, because this laptop runs a non-English Windows.
icacls.exe $adminKeys /inheritance:r /grant "*S-1-5-32-544:F" /grant "*S-1-5-18:F" | Out-Null
Ok "admin file: $adminKeys (ACL locked to Administrators+SYSTEM)"
Restart-Service sshd

# --- 4. cloudflared ---------------------------------------------------------
Step 4 "cloudflared tunnel service"
$cfDir = "C:\Program Files\cloudflared"
$cfExe = Join-Path $cfDir "cloudflared.exe"
if (-not (Test-Path $cfExe)) {
    New-Item -ItemType Directory -Force -Path $cfDir | Out-Null
    $url = "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-windows-amd64.exe"
    Write-Host "    downloading cloudflared"
    Invoke-WebRequest -Uri $url -OutFile $cfExe -UseBasicParsing
    Ok "downloaded to $cfExe"
} else {
    Ok "already present"
}

# A pre-existing service would be bound to a different tunnel token.
if (Get-Service cloudflared -ErrorAction SilentlyContinue) {
    Warn "removing existing cloudflared service"
    & $cfExe service uninstall 2>&1 | Out-Null
    Start-Sleep -Seconds 2
}
& $cfExe service install $TunnelToken 2>&1 | Out-Null
Start-Sleep -Seconds 3
Set-Service -Name cloudflared -StartupType Automatic
Start-Service cloudflared -ErrorAction SilentlyContinue
$cf = Get-Service cloudflared -ErrorAction SilentlyContinue
if ($cf -and $cf.Status -eq "Running") {
    Ok "cloudflared service running"
} else {
    Warn "cloudflared service not running, check: Get-Service cloudflared"
}

# --- 5. Stay-awake + reachable ----------------------------------------------
# A sleeping laptop kills the tunnel. On AC: never sleep, lid close does nothing.
# On battery, normal power saving is left untouched.
Step 5 "Power settings (AC only)"
powercfg /change standby-timeout-ac 0
powercfg /change hibernate-timeout-ac 0
powercfg /change monitor-timeout-ac 20
# SUB_BUTTONS / lid-close-action, 0 = do nothing
powercfg /setacvalueindex SCHEME_CURRENT 4f971e89-eebd-4455-a8de-9e59040e7347 5ca83367-6e45-459f-a27b-476b1d01c936 0
powercfg /setactive SCHEME_CURRENT
Ok "plugged in: never sleeps, lid close ignored"

# --- 6. Firewall: no LAN exposure needed ------------------------------------
# cloudflared reaches sshd over loopback, which Windows Firewall never filters,
# so the inbound rule only exposes port 22 to whatever wifi he is on. Turn it
# off. Re-enable any time with:
#   Enable-NetFirewallRule -Name "OpenSSH-Server-In-TCP"
Step 6 "Firewall"
Disable-NetFirewallRule -Name "OpenSSH-Server-In-TCP" -ErrorAction SilentlyContinue
Ok "inbound port 22 closed to the local network (tunnel unaffected)"

# --- 7. Inventory -----------------------------------------------------------
Step 7 "Machine inventory"
$os  = Get-CimInstance Win32_OperatingSystem
$cpu = (Get-CimInstance Win32_Processor).Name
$ram = [math]::Round($os.TotalVisibleMemorySize / 1MB, 1)
$disk = Get-PSDrive C | Select-Object -ExpandProperty Free
Write-Host "    user     : $SshUser"
Write-Host "    windows  : $($os.Caption) $($os.Version)"
Write-Host "    cpu      : $cpu"
Write-Host "    ram      : $ram GB"
Write-Host "    C: free  : $([math]::Round($disk/1GB,1)) GB"
try {
    $gpu = & nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
    Write-Host "    gpu      : $gpu"
} catch {
    $g = (Get-CimInstance Win32_VideoController | Where-Object { $_.Name -match "NVIDIA" }).Name
    Write-Host "    gpu      : $g  (nvidia-smi not in PATH)"
}

Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host " Done. Send Anri:" -ForegroundColor Cyan
Write-Host "   - the SSH username above  ->  $SshUser"
Write-Host "   - the gpu / ram / disk lines"
Write-Host " Then confirm the tunnel shows HEALTHY in the Cloudflare dashboard."
Write-Host "============================================" -ForegroundColor Cyan
